# ==============================================================================
# Cloud Server Configuration (AI Workstation)
# ==============================================================================

# Server Port and Host
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# PostgreSQL Connection String
# e.g. postgres://username:password@localhost:5432/aiworkstation_cloud
DATABASE_URL=postgres://postgres:password@localhost:5432/aiworkstation

# JWT Secret Key for authenticating client tokens
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# WeChat Open Platform (Scan QR to Login)
# ------------------------------------------------------------------------------
# AppID from WeChat Open Platform (Website Application)
WECHAT_APP_ID=wx_placeholder_app_id
# AppSecret from WeChat Open Platform
WECHAT_APP_SECRET=wx_placeholder_app_secret
# Public callback URL configured in WeChat Open Platform
WECHAT_OAUTH_CALLBACK_URL=https://api.yourdomain.com/api/auth/wx/callback

# ------------------------------------------------------------------------------
# WeChat Pay V3 (Native QR Code Payment)
# ------------------------------------------------------------------------------
# WeChat Pay Merchant ID (mchid)
WECHAT_PAY_MCH_ID=placeholder_mchid
# Merchant API V3 Secret Key (32 characters)
WECHAT_PAY_API_V3_KEY=placeholder_api_v3_key_32_chars
# Merchant API Certificate Serial Number
WECHAT_PAY_SERIAL_NO=placeholder_cert_serial_no
# Merchant Private Key (file path or raw PEM string)
WECHAT_PAY_PRIVATE_KEY_PATH=./certs/apiclient_key.pem
# Public Webhook Notify URL for WeChat Pay asynchronously notifying payment result
WECHAT_PAY_NOTIFY_URL=https://api.yourdomain.com/api/pay/wx-notify
