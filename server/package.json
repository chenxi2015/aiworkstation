{
  "name": "@aiworkstation/cloud-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:node": "tsx watch src/index.ts",
    "build:node": "tsc",
    "start:node": "node dist/index.js",
    "dev": "pnpm run dev:node",
    "build": "pnpm run build:node",
    "start": "pnpm run start:node",
    "dev:cf": "wrangler dev -c wrangler.jsonc",
    "deploy:cf": "wrangler deploy -c wrangler.jsonc",
    "deploy:cf:dry-run": "wrangler deploy -c wrangler.jsonc --dry-run",
    "deploy": "pnpm run deploy:cf",
    "test": "tsx src/test-endpoints.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@aiworkstation/shared-types": "workspace:*",
    "@hono/node-server": "^1.13.8",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.40.0",
    "hono": "^4.7.4",
    "jsonwebtoken": "^9.0.2",
    "postgres": "^3.4.5",
    "qrcode": "^1.5.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.5",
    "drizzle-kit": "^0.30.5",
    "tsx": "^4.19.3",
    "typescript": "^5.8.0",
    "wrangler": "^4.70.0"
  }
}
