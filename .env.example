# ── Docker Windows 专用配置 ──────────────────────────────────────
# macOS / Linux 用户无需设置，留空即可（自动使用宿主机 $HOME）
#
# CONTAINER_HOME：容器内的 HOME 路径（Linux 格式）
#   macOS/Linux: 不填（默认等于宿主机 $HOME，路径容器内外一致）
#   Windows:     /home/user
CONTAINER_HOME=
#
# HOST_DOWNLOADS：宿主机下载目录（挂载进容器供视频下载使用）
#   macOS/Linux: 不填（默认 $HOME/Downloads）
#   Windows:     C:\Users\你的用户名\Downloads
HOST_DOWNLOADS=
