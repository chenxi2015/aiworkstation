# ── Docker Windows 专用配置 ──────────────────────────────────────
# macOS / Linux 用户无需设置，留空即可（自动使用宿主机 $HOME）
#
# CONTAINER_HOME：容器内的 HOME 路径（Linux 格式）
#   macOS/Linux: 不填（默认等于宿主机 $HOME，路径容器内外一致）
#   Windows:     /home/user
CONTAINER_HOME=
#
# HOST_DOWNLOADS：宿主机下载目录（挂载进容器供视频下载使用）
#   macOS/Linux: 不填（默认 $HOME/Downloads）
#   Windows:     C:\Users\你的用户名\Downloads
HOST_DOWNLOADS=

# ── 云端服务（Hono + Cloudflare Workers）─────────────────────────
# 工作台请求的云端接口地址。不配置时默认 http://localhost:4000（本地 server）。
# 生产环境指向部署好的 Worker，例如：
# 注意：Vite 环境变量在构建时注入，修改后需重启 dev server 或重新构建。
VITE_CLOUD_API_BASE=http://localhost:4000

# ── 本地数据与外部工具路径（可选覆盖，留空走默认） ────────────────
# AIWORKSTATION_DATA_DIR：SQLite 数据库 / 备份 / 缓存的根目录
#   默认：~/.aiworkstation
#   需要改存储位置（如外接硬盘、加密卷）时配置
# AIWORKSTATION_DATA_DIR=
#
# YT_DLP_PATH：yt-dlp 可执行文件的绝对路径
#   默认按顺序探测：/opt/homebrew/bin/yt-dlp → /usr/local/bin/yt-dlp → /usr/bin/yt-dlp → which yt-dlp
#   装到非标准位置（/opt/local/bin、自编译）时配置
# YT_DLP_PATH=

# ── 联网搜索引擎 API Key（可选，优先从「设置 → 联网搜索」读取） ──
# 工作台 web_search / web_fetch 工具的搜索引擎密钥。
# 推荐做法：在应用内「设置」配置（随 SQLite 备份迁移）。
# 这里的 env 仅作为 fallback 或团队部署共享同一台服务器时使用。
#
# TAVILY_API_KEY=tvly-xxxxxxxxxxxx
# EXA_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# BRAVE_API_KEY=BSAxxxxxxxxxxxxxxxxx
# JINA_API_KEY=jina_xxxxxxxxxxxxxxxxx   # 可选，不配置也能用（限速更严）

# ── 开源与品牌元数据（可选，留空则使用默认官方仓库与邮箱） ──────
# VITE_GITHUB_REPO=chenxi2015/aiworkstation
# VITE_SUPPORT_EMAIL=bbxycx18@gmail.com
